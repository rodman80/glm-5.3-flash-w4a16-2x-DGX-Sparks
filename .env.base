# BASELINE para A/B (receita default, sem tuning de performance).
# Uso: ENV_FILE=.env.base LOCK_CLOCKS=0 ./start.sh restart
# Gerado a partir do .env atual; só estes knobs diferem: ASYNC=0, micros=0.

# GLM-5.3-Flash W4A16-MTP — 2× DGX Spark (GB10/SM121)
# Copie para .env e ajuste. ./start.sh faz isso no primeiro run.

# --- nodes (nosso cluster) ---------------------------------------------
HEAD_IP=10.100.24.2
WORKER_IP=10.100.24.1
# WORKER_USER vazio = usa $USER (rodman) + ssh config Host 10.100.24.* (IdentityFile nvsync)
WORKER_USER=
WORKER_HOME=
WORKER_SSH=

# Fabric CX7 — detectado em antonius/spark-8352: enp1s0f0np0/rocep1s0f0 UP (10.100.24.x)
# O segundo par enP2p1s0f0np0/roceP2p1s0f0 (10.100.25.x) também UP mas não é o usado no launch canônico HF.
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
# GID RoCEv2 por NIC: índice com ::ffff:10.100.24.x (verificado: 2 e 3 ambos válidos neste par)
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3

# --- weights (canada-quant W4A16-MTP) -----------------------------------
MODEL=canada-quant/glm-5.3-w4a16-mtp
MODEL_REVISION=4eeb77a3499fc2503290197118102eae2ed44553
MODEL_HOST_PATH=/var/tmp/glm-5.3-flash-w4a16-mtp
MODEL_PATH=/models/glm-5.3-flash-w4a16-mtp
CACHE_HOST_PATH=/var/tmp/glm53-w4a16-cache

DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_HOST_PATH=/var/tmp/models/GLM-5.3-Flash-DFlash2
DFLASH_PATH=/models/dflash2-draft

# Imagem canônica do README HF (SM121). Alias Tony é idêntica:
# ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2  (31.2 GiB, já presente nos 2 nós)
IMAGE=radixark/vllm-glm53-flash:sm121-v11-dflash2
IMAGE_FALLBACK=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2

# --- serve --------------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash
PORT=8000
MASTER_PORT=29521
TP=2
NNODES=2

# Clocks GB10 (ver clocks.sh): trava em 2400 MHz — ganho sem calor excessivo.
# Reaplicado a cada boot (hook no start.sh). Reset p/ stock: ./clocks.sh reset.
CLOCK_MHZ=2400

# DFlash2 é o default desta receita (K=7 fixo — qualquer outro wedgea boot)
SPEC_METHOD=dflash
DFLASH_TOKENS=7
MTP_TOKENS=2

# MoE backend: marlin pinado — A/B provou que flashinfer_cutlass nem boota em
# W4A16 (ValueError: só triton/marlin/humming/flashinfer_trtllm/emulation).
# v11-dflash2 suporta ambos; redhat usa flashinfer_cutlass. Ex: MOE_BACKEND=marlin
MOE_BACKEND=marlin
# Micro opts (efeito ~0, ativas e inofensivas: router usa fused topk/atomic-add onde aplica).
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_USE_FUSED_MOE_GROUPED_TOPK=0
# Async scheduling: sobrepoe scheduling de CPU com execucao da GPU (+2-3% decode).
ASYNC_SCHEDULING=0
GPU_MEMORY_UTILIZATION=0.85

# ATENÇÃO KV: HF pinou 9 GiB (1.36M pool) mas Tony alerta que --kv-cache-memory
# bypassa o check de ativações do profiler e pode OOM em prompts longos. Se der
# morte em prefill >3K, remova KV_CACHE_MEMORY (deixe vazio) para o profiler dimensionar.
MAX_MODEL_LEN=1048576
# KV pinado HF 9 GiB: profiler (0.85) só acha 6.96 GiB livres — nem cabe 1x1M
# (precisa 7.05 GiB; erro medido). Pin bypassa o check e serve 1M estável.
# TESTADO sem pin em 2026-09-03: ValueError, pool insuficiente. Manter pinado.
KV_CACHE_MEMORY=9663676416
# Para staging 262K descomente:
# MAX_MODEL_LEN=262144
# KV_CACHE_MEMORY=3221225472
# Para deixar o profiler decidir (fallback seguro): deixe KV_CACHE_MEMORY vazio

# max_num_seqs 6: A/B mostrou saturação em ~80 tok/s já no C6 (C12 não passa disso).
# Workload é codificação agêntica: o ganho real vem de prefix cache (turnos reenviam
# system+contexto), não de concorrência larga. Manter 6 preserva KV p/ contextos longos.
MAX_NUM_SEQS=6
# Block-size 2304 (pin HF — 4608 zera os prefix hits).
BLOCK_SIZE=2304
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8_e4m3
# Batched tokens 8192 (chunking otimo para este lane).
MAX_NUM_BATCHED_TOKENS=8192
# Autotune FlashInfer: neste lane W4A16-Marlin ele sempre salva 0 configs e
# custa ~50-85s por boot (verificado em 2 boots). 1 = --no-enable-flashinfer-autotune.
# Agnóstico: vale p/ qualquer Spark na config padrão; reative com 0 se mudar quant/modelo.
DISABLE_FLASHINFER_AUTOTUNE=1
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600

# HF
HF_HOME=/var/tmp/glm53-w4a16-cache/huggingface
HF_TOKEN=

# APC patch (default 1): corrige prefix-cache híbrido zerado pelo grupo drafter
# (vLLM stock marca eagle em todos os grupos + SWA do drafter zera o min).
# Sem ele: 0 hits medidos. Fail-closed: sem âncoras, boot segue stock.
APPLY_APC_PATCH=1
# Patch kpool top-k SM121 (bind-mount) — deixe vazio para pular.
# Suprimido quando GLM53_SM121_MLA=1 (o overlay gera o indexer a partir deste).
PATCH_KPOOL_HOST=$HOME/patches/sparse_attn_indexer_kpool.py

# SM120 sparse MLA overlay: 0 = baseline SM90 (comportamento atual 100%
# preservado: sem mounts extras, sem mudanca de backend); 1 = monta o overlay
# NoPE->GLM_NSA (docs/patch_sm121_mla.py) + pin mla_attention em
# FLASHINFER_MLA_SPARSE_SM120 via backend_per_kind. Marlin/W4A16 intacto.
# A/B: rode com 0, depois com 1, resto identico. Geracao falha = boot aborta.
GLM53_SM121_MLA=0
# SM121_WORK_DIR=/var/tmp/glm53-w4a16-cache/sm121

# Chat template multimodal (vision) — não publicado no HF, copie do repo se faltar
CHAT_TEMPLATE_MM=chat_template_mm.jinja
