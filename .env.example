# GLM-5.3-Flash W4A16-MTP — 2x DGX Spark (GB10/SM121)
# Copy to .env and adjust. ./start.sh does this on the first run.

# --- nodes (your cluster) ------------------------------------------------
HEAD_IP=192.168.1.2
WORKER_IP=192.168.1.1
# Empty WORKER_USER = use $USER + your ssh config for Host 192.168.1.*
WORKER_USER=
WORKER_HOME=
WORKER_SSH=

# CX7 fabric — detected on the reference kit: enp1s0f0np0/rocep1s0f0 UP (192.168.1.x)
# The second pair enP2p1s0f0np0/roceP2p1s0f0 (192.168.2.x) is also UP but is NOT
# the one used in the canonical HF launch. Adapt names/values to your fabric.
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
# RoCEv2 GID per NIC: the index holding ::ffff:192.168.1.x (here 2 and 3 both valid)
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3
# Dual-fabric NCCL (adopted 2026-09-07): uses both CX7 NICs (.24+.25 fabrics).
# ~2x allreduce BW, ~+5% long-prefill TTFT, decode unchanged. 0 = single-NIC.
# Implemented by the DUAL_NIC block in launch-glm53-w4a16-tp2-dflash2.sh.
DUAL_NIC=1

# --- weights (canada-quant W4A16-MTP) -----------------------------------
MODEL=canada-quant/glm-5.3-w4a16-mtp
MODEL_REVISION=4eeb77a3499fc2503290197118102eae2ed44553
MODEL_HOST_PATH=/var/tmp/glm-5.3-flash-w4a16-mtp
MODEL_PATH=/models/glm-5.3-flash-w4a16-mtp
CACHE_HOST_PATH=/var/tmp/glm53-w4a16-cache

DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_HOST_PATH=/var/tmp/models/GLM-5.3-Flash-DFlash2
DFLASH_PATH=/models/dflash2-draft

# Canonical image (SM121, public, no login needed):
# ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2  (31.2 GiB)
IMAGE=radixark/vllm-glm53-flash:sm121-v11-dflash2
IMAGE_FALLBACK=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2

# --- serve --------------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash
PORT=8000
MASTER_PORT=29521
TP=2
NNODES=2

# DFlash2 is this recipe's default (K=7 fixed — any other count wedges the boot)
SPEC_METHOD=dflash
DFLASH_TOKENS=7
MTP_TOKENS=2

# MoE backend: marlin pinned — A/B proved flashinfer_cutlass doesn't even boot on
# W4A16 (ValueError: only triton/marlin/humming/flashinfer_trtllm/emulation).
# v11-dflash2 supports both; the NVFP4 lane uses flashinfer_cutlass. E.g. MOE_BACKEND=marlin
MOE_BACKEND=marlin

# KV WARNING: HF pinned 9 GiB (1.36M pool) but Tony's GB10-KV-MEMORY-LADDER notes
# that --kv-cache-memory bypasses the profiler's activation check and can OOM on
# long prompts. If the engine dies on >3K prefill, empty KV_CACHE_MEMORY below
# and let the profiler size it.
MAX_MODEL_LEN=1048576
# Pinned HF 9 GiB: the profiler (0.85) only finds 6.96 GiB free — not even 1x1M
# (needs 7.05 GiB; measured error). The pin bypasses the check and serves 1M stable.
# TESTED without pin on 2026-09-03: ValueError, insufficient pool. Keep pinned.
KV_CACHE_MEMORY=9663676416
# For 262K staging uncomment:
# MAX_MODEL_LEN=262144
# KV_CACHE_MEMORY=3221225472
# To let the profiler decide (safe fallback): leave KV_CACHE_MEMORY empty

# max_num_seqs 6: A/B showed saturation at ~80 tok/s already at C6 (C12 never
# exceeds it). The workload is agentic coding: the real win comes from prefix
# cache (turns resend system+context), not wide concurrency. Keeping 6 preserves
# KV for long agent contexts.
MAX_NUM_SEQS=6
# Block-size 2304 (HF pin): 4608 tested, prefix still 0 hits — refuted.
# Current suspect is the mamba-align group (only 2 resident blocks), not block size.
# Next candidate: mamba_cache_mode=all (check memory cost first).
BLOCK_SIZE=2304
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8_e4m3
# Batched tokens: 8192 won the A/B vs 16384 on mixed-prefill (3 waves each, ~125k cold tok):
# decode under load 11.9 vs 11.0 tok/s, steady prefill tied (~48.6s vs ~48.1s),
# cold 53.5s vs 67.3s. Smaller chunks = less head-of-line blocking on decode
# + lower OOM risk with pinned KV. Bench: "max_num_batched_tokens A/B" in benchmarks/RESULTS.md
MAX_NUM_BATCHED_TOKENS=8192
# Async scheduling: sobrepoe scheduling de CPU com execucao da GPU (+2-3% decode).
ASYNC_SCHEDULING=1
# Micro opts (efeito ~0, ativas e inofensivas: router usa fused topk/atomic-add onde aplica).
VLLM_MARLIN_USE_ATOMIC_ADD=1
VLLM_USE_FUSED_MOE_GROUPED_TOPK=1
# Clocks GB10: trava em 2400 MHz via clocks.sh (hook no start.sh, +~5% decode sem calor excessivo).
CLOCK_MHZ=2400
ENFORCE_EAGER=1
# FlashInfer autotune: on this W4A16-Marlin lane it always saves 0 configs and
# costs ~50-85s per boot (verified on 2 boots). 1 = --no-enable-flashinfer-autotune.
# Agnostic: fine for any Spark on the default config; set 0 to re-enable
# when changing quant/model.
DISABLE_FLASHINFER_AUTOTUNE=1
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600

# HF
HF_HOME=/var/tmp/glm53-w4a16-cache/huggingface
HF_TOKEN=

# APC patch (default 1): fixes hybrid prefix-cache zeroed by the drafter group
# (stock vLLM marks eagle on every group + the drafter's SWA zeroes the hybrid min).
# Without it: 0 measured hits. Fail-closed: without anchors, boot continues stock.
APPLY_APC_PATCH=1
# kpool top-k SM121 patch (bind-mount) — leave empty to skip.
# Suppressed when GLM53_SM121_MLA=1 (the overlay generates the indexer from this one).
PATCH_KPOOL_HOST=$HOME/patches/sparse_attn_indexer_kpool.py

# SM120 sparse MLA overlay: 0 = SM90 baseline (current behavior fully
# preserved: no extra mounts, no backend change); 1 = mounts the overlay
# NoPE->GLM_NSA (docs/patch_sm121_mla.py) + pins mla_attention to
# FLASHINFER_MLA_SPARSE_SM120 via backend_per_kind. Marlin/W4A16 untouched.
# A/B: run with 0, then with 1, everything else identical. Generation
# failure = boot aborts.
GLM53_SM121_MLA=0
# SM121_WORK_DIR=/var/tmp/glm53-w4a16-cache/sm121

# Multimodal chat template (vision) — not published on HF, copy from repo if missing
CHAT_TEMPLATE_MM=chat_template_mm.jinja
